# ==============================================================================
# CONFIGURATION ENVIRONMENT VARIABLES (.env.example)
# Sao chép file này thành .env và chỉnh sửa các giá trị phù hợp với môi trường của bạn:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL - spring.datasource)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USERNAME=your_postgres
DB_PASSWORD=your_postgres

# (Tùy chọn: Dành cho cấu hình MySQL nếu chạy qua Docker Compose cũ)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=eguarantee
MYSQL_USER=eguarantee
MYSQL_PASSWORD=Password@123
MYSQL_ROOT_PASSWORD=root

# ------------------------------------------------------------------------------
# 2. JWT & SECURITY (secretkey)
# Khóa bí mật ký token JWT (tối thiểu 256 bits, khuyến nghị chuỗi hex 64 bytes)
# ------------------------------------------------------------------------------
SECRETKEY=your_secretkey
# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (spring.data.redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380

# ------------------------------------------------------------------------------
# 4. GMAIL / SMTP SERVICE (spring.mail)
# Lưu ý: MAIL_PASSWORD là Mật khẩu ứng dụng (App Password) của Gmail, không phải mật khẩu tài khoản
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ------------------------------------------------------------------------------
# 5. VNPAY SANDBOX PAYMENT GATEWAY (vnpay)
# Cấu hình thanh toán thử nghiệm VNPay Sandbox
# ------------------------------------------------------------------------------
VNPAY_TMN_CODE=your_code
VNPAY_HASH_SECRET=your_secretkey
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_IPN_URL=https://localhost:8080/api/v1/payments/vnpay/ipn

# ------------------------------------------------------------------------------
# 6. CLOUDINARY CONFIGURATION (cloudinary)
# Dịch vụ upload và lưu trữ hình ảnh sản phẩm
# ------------------------------------------------------------------------------
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 7. STORE & INVOICE CONFIGURATION (app.invoice)
# ------------------------------------------------------------------------------
EMAIL=your_store_email@gmail.com
INVOICE_STORAGE_PATH=./storage/invoices

# ------------------------------------------------------------------------------
# 8. TRANSACTIONAL EMAIL OUTBOX & DEMO (REQ-03)
# ------------------------------------------------------------------------------
DEMO_FAIL_AFTER_PAID=false
EMAIL_OUTBOX_BACKOFF_BASE=60
