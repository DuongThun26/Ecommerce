            </textField>

            <textField pattern="#,##0">
                <reportElement x="195" y="0" width="140" height="22" uuid="3d8e9ab7-3eb3-4df4-a4f6-7b2432655bc1"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
