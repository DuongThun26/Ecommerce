            <staticText>
                <reportElement mode="Opaque" x="335" y="0" width="200" height="25" backcolor="#F0F0F0" uuid="d9e1cb4a-80bb-4a17-ba5d-e5c6a4d87714"/>
                <box rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </box>
